# Google Tag Manager Container ID (e.g., GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Base path for deployment (e.g., /your-repo-name for GitHub Pages; leave empty for a custom domain)
NEXT_PUBLIC_BASE_PATH=

# Google Apps Script web app URL that receives all website forms
# (see scripts/google-apps-script/README.md), e.g. https://script.google.com/macros/s/XXXX/exec
NEXT_PUBLIC_FORMS_ENDPOINT=
